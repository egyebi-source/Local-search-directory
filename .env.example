# Copy to .env.local for local development (never commit .env.local).
# Real values live in Vercel → Project → Settings → Environment Variables.
# Mark every secret below as "Sensitive" in Vercel. Placeholders only here.

# --- Database (filled automatically by the Vercel ↔ Neon integration) ---
DATABASE_URL=                 # Neon pooled, app_user role (limited; no table ownership)
DATABASE_URL_UNPOOLED=        # Neon direct, migration owner role

# --- Login (Phase 1) ---
AUTH_SECRET=                  # 32+ random bytes: `openssl rand -base64 32`. Different per environment.
AUTH_URL=                     # e.g. http://localhost:3000 locally; not needed on Vercel
GOOGLE_LOGIN_CLIENT_ID=       # optional; Google button appears only when both are set
GOOGLE_LOGIN_CLIENT_SECRET=
RESEND_API_KEY=               # required on Vercel; locally, sign-in links print to the terminal
EMAIL_FROM=                   # e.g. "TorqueRank <login@your-domain>"

# --- Google data connection (Phase 3) ---
GOOGLE_DATA_CLIENT_ID=
GOOGLE_DATA_CLIENT_SECRET=
GOOGLE_DATA_REDIRECT_URI=
TOKEN_ENCRYPTION_KEY=         # 32 random bytes, base64. Different key per environment.
TOKEN_ENCRYPTION_KEY_VERSION=1

# --- Competitor data + AI (Phase 2) ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=
DAILY_SPEND_CAP_DATAFORSEO_CENTS=
DAILY_SPEND_CAP_GEMINI_CENTS=

# --- Rate limiting + bot protection (Phase 2) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TURNSTILE_SITE_KEY=           # the only value allowed in the browser (as NEXT_PUBLIC_TURNSTILE_SITE_KEY)
TURNSTILE_SECRET_KEY=

# --- Scheduled sync (Phase 4) ---
CRON_SECRET=

# --- Monitoring (Phase 7) ---
SENTRY_DSN=
